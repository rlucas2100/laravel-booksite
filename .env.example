APP_NAME=Cliffhanger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite needs no setup: the file is database/database.sqlite.
# For MySQL, set DB_CONNECTION=mysql and fill in the five lines below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cliffhanger
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# "log" writes emails (password resets) to storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- The shop -------------------------------------------------------------

# true = safe to leave open to the public: what visitors make is only shown
# to their own browser and is deleted after a day. See app/Support/Sandbox.php
SHOP_DEMO=false
SHOP_SANDBOX_HOURS=24

# true = build and fill the database on the first visit (hosts with no command line)
SHOP_AUTO_INSTALL=false

# The owner (Super-Admin) account made by the seeder. Use OWNER_PASSWORD on your
# own machine, or OWNER_PASSWORD_HASH (bcrypt, 12 rounds) on a server.
OWNER_NAME=AstroQuack
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_PASSWORD_HASH=

# Stripe (optional). Use the TEST keys from dashboard.stripe.com: the demo refuses live ones.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Footer links (optional)
SHOP_SOURCE_URL=
SHOP_HOME_URL=

VITE_APP_NAME="${APP_NAME}"
